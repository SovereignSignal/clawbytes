# ClawBytes configuration. Copy to .env (gitignored) and fill in.
# State is JSON on a volume — there is NO database.

# Audience channel (required)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHANNEL_ID=-100xxxxxxxxxx

# State volume (Railway sets this to the mounted volume path)
CLAWBYTES_MEMORY_DIR=/data/memory

# Publish gate: 1/true to actually post; otherwise dry-run
CLAWBYTES_PUBLISH=0

# Ops alerts — your own Telegram user chat id (DM the bot once, read it from
# getUpdates). The bot DMs here ONLY on breakage.
CLAWBYTES_ADMIN_CHAT_ID=

# Slack mirror of channel posts (optional)
SLACK_BOT_TOKEN=
CLAWBYTES_SLACK_CHANNEL_ID=

# Enrichment LLM, OpenAI-compatible (optional — without it, lanes use the
# bare fallback renderer). OPENAI_API_KEY is used if CLAWBYTES_LLM_API_KEY is unset.
CLAWBYTES_LLM_URL=
CLAWBYTES_LLM_MODEL=
CLAWBYTES_LLM_API_KEY=

# Lifts GitHub API limits (release-note grounding, leaderboard/registry sha
# checks, discovery). Recommended.
GITHUB_TOKEN=

# Discovery search (optional)
BRAVE_API_KEY=
