# ClawBytes Configuration

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHANNEL_ID=-100xxxxxxxxxx

# Operational/status reports DM target (your own Telegram user chat id;
# message the bot once, then read it from getUpdates)
CLAWBYTES_ADMIN_CHAT_ID=

# Database (Railway auto-sets this, or use local Postgres)
DATABASE_URL=postgresql://user:pass@localhost:5432/clawbytes

# Optional: Brave API for discovery features
# BRAVE_API_KEY=your_brave_key_here
